{
  "uid": "agent-operations",
  "title": "Agent operations",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "agent-platform",
    "pedagogical"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Cobertura",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Tráfico y latencia del proxy. **No equivalen a tareas completadas del agente.** Los spans de OpenHands requieren el paso optativo de tracing nativo."
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Spans por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name,span_name) (rate(agent_calls_total[5m]))",
          "legendFormat": "{{service_name}} {{span_name}} {{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Errores por segundo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(agent_calls_total{status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "legendFormat": "{{service_name}} {{span_name}} {{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Latencia p95 de spans (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,service_name,span_name) (rate(agent_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service_name}} {{span_name}} {{gen_ai_token_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 4
    }
  ],
  "links": [
    {
      "title": "Vista general de la plataforma",
      "type": "link",
      "url": "/d/platform-overview",
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
